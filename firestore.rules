rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    match /households/{householdId} {
      function household() {
        return get(/databases/$(database)/documents/households/$(householdId)).data;
      }

      function isMember() {
        return signedIn() && myEmail() in household().members;
      }

      // Roles (@huishouden/pwa-kit/roles): `roles` maps a member's email to admin, member, helper or
      // kid. Anyone it doesn't name is a member, except the household's creator (members[0], which
      // the create rule guarantees and the update rule keeps) who is an admin. get() is cached per
      // request, so every check below reads the household document once.
      function roleOf(d, email) {
        return d.get('roles', {}).get(email, d.members[0] == email ? 'admin' : 'member');
      }

      function role() {
        return roleOf(household(), myEmail());
      }

      // Admins and members: everything in every app (admins also manage people and roles).
      function staff() {
        return isMember() && role() in ['admin', 'member'];
      }

      // Helpers (a babysitter, the shared wall tablet) and kids: they read the household's everyday
      // things, tick them off and add their own, and change or remove only what they added.
      function helping() {
        return isMember() && role() in ['helper', 'kid'];
      }

      function signsAsMe() {
        return request.resource.data.get('by', '') == myEmail();
      }

      function addedByMe() {
        return resource.data.get('by', '') == myEmail();
      }

      // Who may create or update a shared record: admins and members always; helpers and kids
      // create in their own name and update what they added, and on anyone's record may change
      // only `ticks`, the fields that check it off.
      function writer(ticks) {
        return staff()
          || (helping() && (request.method == 'create'
            ? signsAsMe()
            : ((addedByMe() && signsAsMe()) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(ticks))));
      }

      // Made from the person's own AI assistant (huishouden/connector), which writes as them under
      // these same rules: records it creates may say so, and only that way.
      function viaOk(d) {
        return !('via' in d) || d.via == 'assistant';
      }

      function canRemove() {
        return staff() || (helping() && addedByMe());
      }

      // Private records (contacts, appointments, agenda items and reminders with `private: true`)
      // are for admins and members. One without the flag counts as private to helpers and kids
      // until it is written with `private: false`, so nothing written before roles existed leaks;
      // their queries filter on `private == false`.
      function readable() {
        return staff() || (isMember() && resource.data.get('private', true) == false);
      }

      function openBefore() {
        return resource.data.get('private', true) == false;
      }

      // `private` is optional and a boolean. A helper's or kid's writes stay open, never private
      // and never over a private record, so they never write what they can't read.
      function privateFlag() {
        return request.resource.data.get('private', false) is bool
          && (staff() || (request.resource.data.get('private', true) == false
            && (request.method == 'create' || openBefore())));
      }

      // Spending and Bills: money, for admins and members only, including what those apps publish
      // to the shared agenda and reminders.
      function moneyApp(app) {
        return app in ['spending', 'bills'];
      }

      allow read: if signedIn() && myEmail() in resource.data.members;

      function householdName(d) {
        return d.name is string && d.name.size() <= 100;
      }

      // The currency every app shows amounts in (ISO 4217, "USD"); unset means US dollars.
      function householdCurrency(d) {
        return !('currency' in d) || (d.currency is string && d.currency.matches('[A-Z]{3}'));
      }

      // Lowercase emails, checked as one string because rules have no loops: joined with spaces
      // (which no address contains), each entry must look like an address with no capitals, and
      // splitting back must give the same list, which fails for anything that isn't a string.
      function memberEmails(l) {
        let one = '[^ @A-Z]{1,128}@[^ @A-Z]{1,128}';
        return l is list && l.size() >= 1 && l.size() <= 12
          && l.join(' ').matches(one + '( ' + one + ')*') && l.join(' ').split(' ') == l;
      }

      // A new household starts with only its creator, its admin; others are invited from inside.
      // Apps open the oldest household a person belongs to, so `createdAt` must be the real time
      // of creation (within an hour, for clock drift): a backdated household could otherwise
      // invite someone and take the place of their own in every app.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'members', 'createdAt', 'roles'])
        && request.resource.data.members == [myEmail()]
        && (!('roles' in request.resource.data) || (request.resource.data.roles is map
          && request.resource.data.roles.keys().hasOnly([myEmail()])
          && request.resource.data.roles.get(myEmail(), '') == 'admin'))
        && householdName(request.resource.data)
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > request.time.toMillis() - 3600000
        && request.resource.data.createdAt < request.time.toMillis() + 3600000;

      // Roles name only members, each with one of the four roles.
      function rolesShape(d) {
        return !('roles' in d) || (d.roles is map
          && d.roles.keys().hasOnly(d.members)
          && d.roles.values().hasOnly(['admin', 'member', 'helper', 'kid']));
      }

      // Admins invite and remove people and set roles, but never their own: an admin can't remove
      // or demote themselves, so a household always keeps one. The creator is the implicit admin
      // as members[0], so whoever else becomes first in the list must have their role written out.
      // Members may rename the household and set its currency; helpers and kids change nothing here. Separately, each
      // member records their own first sign-in in `joined`, and only their own.
      allow update: if signedIn()
        && myEmail() in resource.data.members
        && (
          (roleOf(resource.data, myEmail()) == 'admin'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'members', 'roles', 'currency'])
            && memberEmails(request.resource.data.members)
            && householdName(request.resource.data)
            && householdCurrency(request.resource.data)
            && rolesShape(request.resource.data)
            && myEmail() in request.resource.data.members
            && roleOf(request.resource.data, myEmail()) == 'admin'
            && (request.resource.data.members[0] == resource.data.members[0]
              || request.resource.data.members[0] in request.resource.data.get('roles', {})))
          || (roleOf(resource.data, myEmail()) == 'member'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'currency'])
            && householdName(request.resource.data)
            && householdCurrency(request.resource.data))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined'])
            && request.resource.data.joined == resource.data.get('joined', []).concat([myEmail()]))
        );

      allow delete: if false;

      // Lists are written in the same batch that creates the household, so the role is checked
      // against the state after the write. Lists are the household's setup: admins and members.
      function staffAfter() {
        let d = getAfter(/databases/$(database)/documents/households/$(householdId)).data;
        return signedIn() && myEmail() in d.members && roleOf(d, myEmail()) in ['admin', 'member'];
      }

      match /lists/{listId} {
        allow read: if isMember();
        allow write: if staffAfter();
      }

      match /items/{itemId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer(['completed', 'completedAt', 'updatedAt', 'subtasks', 'position'])
          && viaOk(request.resource.data)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.listId is string
          && request.resource.data.completed is bool
          // Cancelled (from Tasks or the portal's To-do list): kept, ticked off, in the history.
          && (!('cancelledAt' in request.resource.data) || request.resource.data.cancelledAt is int)
          && (!('cancelledBy' in request.resource.data) || hhStr(request.resource.data, 'cancelledBy', 0, 254))
          && (!('subtasks' in request.resource.data) || (request.resource.data.subtasks is list && request.resource.data.subtasks.size() <= 50))
          // Ticking a step off someone else's item keeps its steps (Tasks rewrites the whole list).
          && (staff() || request.method == 'create' || addedByMe()
            || request.resource.data.get('subtasks', []).size() == resource.data.get('subtasks', []).size())
          // Shown as a link on every member's list: a web address or nothing.
          && (!('link' in request.resource.data) || request.resource.data.link == ''
            || (request.resource.data.link is string && request.resource.data.link.size() <= 2000
              && request.resource.data.link.matches('(?i)https?://[^ ]+')));
      }

      // Counts and categories remembered as anyone adds and ticks items, so any member writes them.
      match /staples/{stapleId} {
        allow read, write: if isMember();
      }

      match /stores/{storeId} {
        allow read: if isMember();
        allow delete: if staff();
        allow create, update: if staff()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.categoryOrder is list
          && request.resource.data.categoryOrder.size() <= 20;

        match /aisles/{itemKey} {
          allow read, delete: if isMember();
          allow create, update: if isMember()
            && request.resource.data.aisle is string
            && request.resource.data.aisle.size() > 0
            && request.resource.data.aisle.size() <= 24;
        }
      }

      // Huishouden Spending: the household's card spending, for admins and members only, written by
      // their browsers (statement files, card alert emails, category edits). A household's legacy
      // Apps Script also writes
      // spendingTransactions with its owner's IAM credentials, which bypass these rules. Field lists
      // match TRANSACTION_FIELDS, SETTINGS_FIELDS, CARD_FIELDS, CSV_FIELDS and RULE_FIELDS in the
      // app's src/data/model.ts.
      function spStr(d, k, lo, hi) {
        return d[k] is string && d[k].size() >= lo && d[k].size() <= hi;
      }
      function spOptStr(d, k, hi) {
        return !(k in d) || spStr(d, k, 0, hi);
      }
      function spWords(d, k, maxItems) {
        return d[k] is list && d[k].size() <= maxItems;
      }

      match /spendingTransactions/{txId} {
        allow read, delete: if staff();
        allow create, update: if staff()
          && request.resource.data.keys().hasOnly(['date', 'description', 'amount', 'category', 'card', 'type', 'source', 'last4', 'emailId', 'createdAt', 'updatedAt', 'by'])
          && isYmd(request.resource.data.date)
          && spStr(request.resource.data, 'description', 1, 200)
          && request.resource.data.amount is number
          && request.resource.data.amount >= -10000000 && request.resource.data.amount <= 10000000
          && spStr(request.resource.data, 'category', 0, 60)
          && spStr(request.resource.data, 'card', 0, 60)
          && spStr(request.resource.data, 'type', 0, 20)
          && request.resource.data.source in ['statement', 'alert']
          && (!('last4' in request.resource.data) || (request.resource.data.last4 is string && request.resource.data.last4.matches('^[0-9]{4}$')))
          && spOptStr(request.resource.data, 'emailId', 64)
          && request.resource.data.createdAt is int
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is int)
          && spStr(request.resource.data, 'by', 1, 200);
      }

      // One document, `main`: budget, currency, words never counted, Gmail labels, last email check.
      match /spendingSettings/{docId} {
        allow read: if staff();
        allow delete: if false;
        allow create, update: if staff()
          && docId == 'main'
          && request.resource.data.keys().hasOnly(['monthlyBudget', 'currencySymbol', 'ignoredKeywords', 'alertLabels', 'emailCheckedAt', 'emailCheckedBy', 'updatedAt', 'updatedBy'])
          && (!('monthlyBudget' in request.resource.data) || (request.resource.data.monthlyBudget is number
            && request.resource.data.monthlyBudget >= 0 && request.resource.data.monthlyBudget <= 100000000))
          && spOptStr(request.resource.data, 'currencySymbol', 4)
          && (!('ignoredKeywords' in request.resource.data) || spWords(request.resource.data, 'ignoredKeywords', 100))
          && (!('alertLabels' in request.resource.data) || spWords(request.resource.data, 'alertLabels', 20))
          && (!('emailCheckedAt' in request.resource.data) || request.resource.data.emailCheckedAt is int)
          && spOptStr(request.resource.data, 'emailCheckedBy', 200)
          && request.resource.data.updatedAt is int
          && spStr(request.resource.data, 'updatedBy', 1, 200);
      }

      match /spendingCards/{cardId} {
        allow read, delete: if staff();
        allow create, update: if staff()
          && request.resource.data.keys().hasOnly(['name', 'last4', 'issuer', 'alertWords', 'csv', 'createdAt', 'updatedAt', 'by'])
          && spStr(request.resource.data, 'name', 1, 60)
          && (!('last4' in request.resource.data) || (request.resource.data.last4 is string && request.resource.data.last4.matches('^[0-9]{4}$')))
          && spOptStr(request.resource.data, 'issuer', 40)
          && spWords(request.resource.data, 'alertWords', 20)
          && (!('csv' in request.resource.data) || (request.resource.data.csv is map
            && request.resource.data.csv.keys().hasOnly(['date', 'description', 'amount', 'debit', 'credit', 'category', 'type', 'card', 'purchases', 'dayFirst'])
            && request.resource.data.csv.purchases in ['negative', 'positive']
            && request.resource.data.csv.dayFirst is bool))
          && request.resource.data.createdAt is int
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is int)
          && spStr(request.resource.data, 'by', 1, 200);
      }

      // "When the merchant contains X, the category is Y."
      match /spendingRules/{ruleId} {
        allow read, delete: if staff();
        allow create, update: if staff()
          && request.resource.data.keys().hasOnly(['contains', 'category', 'createdAt', 'updatedAt', 'by'])
          && spStr(request.resource.data, 'contains', 1, 80)
          && spStr(request.resource.data, 'category', 1, 60)
          && request.resource.data.createdAt is int
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is int)
          && spStr(request.resource.data, 'by', 1, 200);
      }

      // Huishouden Baby: the household's shared baby log, checklists and appointments.
      match /babyProfile/{docId} {
        allow read: if isMember();
        allow write: if staff()
          && docId == 'main'
          && request.resource.data.keys().hasOnly(['name', 'dueDate', 'birthDate', 'updatedAt', 'updatedBy'])
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60));
      }

      // Anyone may end a sleep someone else started (the babysitter records the wake-up).
      match /babyEvents/{eventId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer(['endAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['kind', 'at', 'endAt', 'side', 'method', 'amountMl', 'diaper', 'note', 'by', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['feed', 'sleep', 'diaper', 'pump']
          && request.resource.data.at is int
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500));
      }

      match /babyChecklists/{itemId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer(['done', 'order'])
          // Skipped: not needed after all, kept in the list's history.
          && (!('skipped' in request.resource.data) || request.resource.data.skipped is bool)
          && (!('skippedAt' in request.resource.data) || request.resource.data.skippedAt is int)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200;
      }

      match /babyAppointments/{appointmentId} {
        allow read: if readable();
        allow delete: if canRemove() && (staff() || openBefore());
        allow create, update: if writer([]) && privateFlag()
          && viaOk(request.resource.data)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.at is int
          && (!('calendarLink' in request.resource.data) || (request.resource.data.calendarLink is string
            && request.resource.data.calendarLink.size() <= 2000 && request.resource.data.calendarLink.matches('https://.+')));
      }

      // Huishouden Car: the household's cars, their service schedules, odometer readings,
      // renewals, service history and service appointments. Shops are shared contacts.
      function carStr(d, k, max) {
        return !(k in d) || (d[k] is string && d[k].size() <= max);
      }
      function carName(d, k, max) {
        return d[k] is string && d[k].size() > 0 && d[k].size() <= max;
      }
      function carInt(d, k, lo, hi) {
        return !(k in d) || (d[k] is int && d[k] >= lo && d[k] <= hi);
      }
      function carYmd(d, k) {
        return d[k] is string && d[k].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      function carStamp(d) {
        return d.createdAt is int && d.by is string && d.by.size() <= 120 && carInt(d, 'updatedAt', 0, 9007199254740991);
      }

      match /carVehicles/{vehicleId} {
        allow read: if isMember();
        allow delete: if staff();
        allow create, update: if staff()
          && request.resource.data.keys().hasOnly(['name', 'make', 'model', 'year', 'notes', 'createdAt', 'updatedAt', 'by'])
          && carName(request.resource.data, 'name', 60)
          && carStr(request.resource.data, 'make', 40)
          && carStr(request.resource.data, 'model', 40)
          && carInt(request.resource.data, 'year', 1900, 2100)
          && carStr(request.resource.data, 'notes', 500)
          && carStamp(request.resource.data);
      }

      match /carServiceItems/{itemId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer(['lastDate', 'lastOdometer', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['vehicleId', 'name', 'everyMonths', 'everyDistance', 'lastDate', 'lastOdometer', 'notes', 'pausedAt', 'createdAt', 'updatedAt', 'by'])
          // Paused: no longer comes due until resumed.
          && carInt(request.resource.data, 'pausedAt', 0, 9007199254740991)
          && carName(request.resource.data, 'vehicleId', 128)
          && carName(request.resource.data, 'name', 80)
          && ('everyMonths' in request.resource.data || 'everyDistance' in request.resource.data)
          && carInt(request.resource.data, 'everyMonths', 1, 240)
          && carInt(request.resource.data, 'everyDistance', 1, 1000000)
          && (!('lastDate' in request.resource.data) || carYmd(request.resource.data, 'lastDate'))
          && carInt(request.resource.data, 'lastOdometer', 0, 9999999)
          && carStr(request.resource.data, 'notes', 500)
          && carStamp(request.resource.data);
      }

      match /carOdometer/{readingId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([])
          && request.resource.data.keys().hasOnly(['vehicleId', 'date', 'reading', 'note', 'createdAt', 'updatedAt', 'by'])
          && carName(request.resource.data, 'vehicleId', 128)
          && carYmd(request.resource.data, 'date')
          && request.resource.data.reading is int
          && carInt(request.resource.data, 'reading', 0, 9999999)
          && carStr(request.resource.data, 'note', 200)
          && carStamp(request.resource.data);
      }

      match /carRenewals/{renewalId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer(['dueDate', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['vehicleId', 'kind', 'name', 'dueDate', 'everyMonths', 'notes', 'closedAt', 'createdAt', 'updatedAt', 'by'])
          // Closed (handled, not renewing): no longer comes due, kept in the car's history.
          && carInt(request.resource.data, 'closedAt', 0, 9007199254740991)
          && carStr(request.resource.data, 'vehicleId', 128)
          && request.resource.data.kind in ['registration', 'insurance', 'inspection', 'toll', 'other']
          && carName(request.resource.data, 'name', 80)
          && carYmd(request.resource.data, 'dueDate')
          && carInt(request.resource.data, 'everyMonths', 1, 120)
          && carStr(request.resource.data, 'notes', 500)
          && carStamp(request.resource.data);
      }

      match /carServiceLog/{entryId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([])
          && request.resource.data.keys().hasOnly(['vehicleId', 'date', 'odometer', 'what', 'serviceItemIds', 'shopId', 'costCents', 'notes', 'createdAt', 'updatedAt', 'by'])
          && carName(request.resource.data, 'vehicleId', 128)
          && carYmd(request.resource.data, 'date')
          && carInt(request.resource.data, 'odometer', 0, 9999999)
          && carName(request.resource.data, 'what', 120)
          && (!('serviceItemIds' in request.resource.data) || (request.resource.data.serviceItemIds is list && request.resource.data.serviceItemIds.size() <= 20))
          && carStr(request.resource.data, 'shopId', 128)
          && carInt(request.resource.data, 'costCents', 0, 100000000)
          && carStr(request.resource.data, 'notes', 1000)
          && carStamp(request.resource.data);
      }

      match /carAppointments/{appointmentId} {
        allow read: if readable();
        allow delete: if canRemove() && (staff() || openBefore());
        allow create, update: if writer([]) && privateFlag()
          && request.resource.data.keys().hasOnly(['vehicleId', 'title', 'at', 'location', 'notes', 'shopId', 'calendarEventId', 'calendarLink', 'private', 'createdAt', 'updatedAt', 'by', 'via'])
          && viaOk(request.resource.data)
          && carStr(request.resource.data, 'vehicleId', 128)
          && carName(request.resource.data, 'title', 120)
          && request.resource.data.at is int
          && carStr(request.resource.data, 'location', 200)
          && carStr(request.resource.data, 'notes', 500)
          && carStr(request.resource.data, 'shopId', 128)
          && carStr(request.resource.data, 'calendarEventId', 1024)
          && (!('calendarLink' in request.resource.data) || (request.resource.data.calendarLink is string
            && request.resource.data.calendarLink.matches('https://.*') && request.resource.data.calendarLink.size() <= 2000))
          && carStamp(request.resource.data);
      }

      // One document, `main`: the unit the household's odometers read in.
      match /carSettings/{docId} {
        allow read: if isMember();
        allow write: if staff()
          && docId == 'main'
          && request.resource.data.keys().hasOnly(['distanceUnit', 'updatedAt', 'updatedBy'])
          && request.resource.data.distanceUnit in ['mi', 'km']
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedBy is string;
      }

      // Huishouden Home: the house's upkeep jobs with their schedules, the service history, and
      // warranties. Field lists match TASK_KEYS, SERVICE_KEYS and WARRANTY_KEYS in the app's model.
      function isYmd(v) {
        return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      function optString(d, key, max) {
        return !(key in d) || (d[key] is string && d[key].size() <= max);
      }

      function optYmd(d, key) {
        return !(key in d) || isYmd(d[key]);
      }

      function optLink(d, key) {
        return !(key in d) || (d[key] is string && d[key].size() <= 500 && d[key].matches('https://.+'));
      }

      function stamped(d) {
        return d.createdAt is int
          && d.by is string && d.by.size() <= 200
          && (!('updatedAt' in d) || d.updatedAt is int);
      }

      function isSchedule(s) {
        return s is map
          && s.keys().hasOnly(['kind', 'every', 'unit', 'anchor'])
          && s.kind in ['after-done', 'fixed']
          && s.every is int && s.every >= 1 && s.every <= 99
          && s.unit in ['day', 'week', 'month', 'year']
          && (s.kind == 'after-done' ? !('anchor' in s) : isYmd(s.get('anchor', null)));
      }

      match /homeTasks/{taskId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer(['due', 'lastDone', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['title', 'category', 'schedule', 'due', 'lastDone', 'contactId', 'notes', 'calendarEventId', 'calendarLink', 'pausedAt', 'createdAt', 'updatedAt', 'by'])
          // Paused: kept, no longer comes due until resumed.
          && (!('pausedAt' in request.resource.data) || request.resource.data.pausedAt is int)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.category in ['hvac', 'pest', 'lawn', 'gutters', 'plumbing', 'electrical', 'appliances', 'safety', 'pool', 'paperwork', 'other']
          && isSchedule(request.resource.data.schedule)
          && isYmd(request.resource.data.due)
          && optYmd(request.resource.data, 'lastDone')
          && optString(request.resource.data, 'contactId', 100)
          && optString(request.resource.data, 'notes', 1000)
          && optString(request.resource.data, 'calendarEventId', 1024)
          && optLink(request.resource.data, 'calendarLink')
          && stamped(request.resource.data);
      }

      match /homeServiceLog/{entryId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([])
          && request.resource.data.keys().hasOnly(['date', 'title', 'taskId', 'contactId', 'who', 'costCents', 'notes', 'calendarEventId', 'calendarLink', 'createdAt', 'updatedAt', 'by', 'via'])
          && viaOk(request.resource.data)
          && isYmd(request.resource.data.date)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && optString(request.resource.data, 'taskId', 100)
          && optString(request.resource.data, 'contactId', 100)
          && optString(request.resource.data, 'who', 120)
          && (!('costCents' in request.resource.data) || (request.resource.data.costCents is int
            && request.resource.data.costCents >= 0 && request.resource.data.costCents <= 100000000))
          && optString(request.resource.data, 'notes', 1000)
          && optString(request.resource.data, 'calendarEventId', 1024)
          && optLink(request.resource.data, 'calendarLink')
          && stamped(request.resource.data);
      }

      match /homeWarranties/{warrantyId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([])
          && request.resource.data.keys().hasOnly(['item', 'details', 'purchaseDate', 'warrantyEnd', 'receiptUrl', 'manualUrl', 'contactId', 'notes', 'createdAt', 'updatedAt', 'by'])
          && request.resource.data.item is string
          && request.resource.data.item.size() > 0
          && request.resource.data.item.size() <= 120
          && optString(request.resource.data, 'details', 200)
          && optYmd(request.resource.data, 'purchaseDate')
          && optYmd(request.resource.data, 'warrantyEnd')
          && optLink(request.resource.data, 'receiptUrl')
          && optLink(request.resource.data, 'manualUrl')
          && optString(request.resource.data, 'contactId', 100)
          && optString(request.resource.data, 'notes', 1000)
          && stamped(request.resource.data);
      }

      // Home's regular events: things that come and go on a schedule whether or not anyone does
      // anything (garbage pickup every Thursday, a lawn service every other Friday). Fields match
      // EVENT_KEYS in the app's model; `rule` is EventRule, `prep` EventPrep and `exceptions`
      // OccurrenceChanges in @huishouden/pwa-kit/schedule.
      function isHhmm(v) {
        return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
      }

      function isEventRule(r) {
        return r is map
          && r.keys().hasOnly(['freq', 'every', 'start', 'days', 'nth', 'weekday', 'until'])
          && r.get('freq', '') in ['week', 'month', 'year']
          && r.get('every', 0) is int && r.every >= 1 && r.every <= 99
          && isYmd(r.get('start', null))
          && (!('until' in r) || (isYmd(r.until) && r.until >= r.start))
          && (!('days' in r) || (r.freq == 'week' && r.days is list
            && r.days.size() >= 1 && r.days.size() <= 7 && r.days.hasOnly([0, 1, 2, 3, 4, 5, 6])))
          && (('nth' in r) == ('weekday' in r))
          && (!('nth' in r) || (r.freq == 'month' && r.nth in [1, 2, 3, 4, -1] && r.weekday in [0, 1, 2, 3, 4, 5, 6]));
      }

      function isEventPrep(p) {
        return p is map
          && p.keys().hasOnly(['title', 'offset', 'remind'])
          && p.keys().hasAll(['title', 'offset', 'remind'])
          && p.title is string && p.title.size() > 0 && p.title.size() <= 120
          && p.offset is map
          && p.offset.keys().hasOnly(['daysBefore', 'time'])
          && p.offset.get('daysBefore', null) is int && p.offset.daysBefore >= 0 && p.offset.daysBefore <= 14
          && isHhmm(p.offset.get('time', null))
          && p.remind is bool;
      }

      // Changes to single occurrences, keyed by the day the schedule put each on: at most 100, each
      // key a day (checked as one joined string, since rules have no loops). The app reads every
      // value defensively (toChange in the kit), keeping only a valid move or skip and a short note.
      function isOccurrenceChanges(c) {
        let day = '[0-9]{4}-[0-9]{2}-[0-9]{2}';
        return c is map && c.size() <= 100
          && (c.size() == 0 || c.keys().join(' ').matches(day + '( ' + day + ')*'));
      }

      match /homeEvents/{eventId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([])
          && eventId.matches('[A-Za-z0-9-]{1,100}')
          && request.resource.data.keys().hasOnly(['title', 'kind', 'rule', 'time', 'contactId', 'notes', 'prep', 'exceptions', 'createdAt', 'updatedAt', 'by', 'via'])
          && viaOk(request.resource.data)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.kind in ['trash', 'recycling', 'yard waste', 'lawn', 'hoa', 'cleaning', 'other']
          && isEventRule(request.resource.data.rule)
          && (!('time' in request.resource.data) || isHhmm(request.resource.data.time))
          && optString(request.resource.data, 'contactId', 100)
          && optString(request.resource.data, 'notes', 1000)
          && (!('prep' in request.resource.data) || isEventPrep(request.resource.data.prep))
          && (!('exceptions' in request.resource.data) || isOccurrenceChanges(request.resource.data.exceptions))
          && stamped(request.resource.data);
      }

      // A thing to do before one occurrence, ticked off: `<eventId>_<day of the occurrence>` (event
      // ids have no underscore, so the id splits back into the event's). Anyone
      // in the household ticks it in their own name (helpers and kids included: putting the bins out
      // is everyday work), for an event that exists; Undo removes your own tick, and admins and
      // members remove anyone's.
      match /homeEventPrep/{prepId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if isMember()
          && prepId.matches('[A-Za-z0-9-]{1,100}_[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && exists(/databases/$(database)/documents/households/$(householdId)/homeEvents/$(prepId.split('_')[0]))
          && request.resource.data.keys().hasOnly(['done', 'skipped', 'at', 'by'])
          && request.resource.data.done == true
          // Skipped rather than done: not needed this time.
          && (!('skipped' in request.resource.data) || request.resource.data.skipped is bool)
          && request.resource.data.at is int
          && signsAsMe();
      }

      // Huishouden Bills: bill sources (which emails are whose bills), bills (bill/v1), and each
      // member's last email check. Field lists match the app's src/lib/model.ts.
      function billKinds() {
        return ['electric', 'gas', 'water', 'internet', 'phone', 'mortgage', 'hoa', 'insurance', 'other'];
      }

      function billMoney(v) {
        return v == null
          || (v is map && v.keys().hasOnly(['amount', 'currency'])
            && v.amount is string && v.amount.matches('^-?[0-9]{1,12}[.][0-9]{2}$')
            && v.currency is string && v.currency.matches('^[A-Z]{3}$'));
      }

      function billAutopay(v) {
        return v == null
          || (v is map && v.keys().hasOnly(['enrolled', 'nextDraft', 'via'])
            && v.enrolled is bool
            && (!('nextDraft' in v) || isYmd(v.nextDraft))
            && (!('via' in v) || v.via in ['card']));
      }

      match /billSources/{sourceId} {
        allow read, delete: if staff();
        allow create, update: if staff()
          && request.resource.data.keys().hasOnly(['name', 'kind', 'from', 'subject', 'label', 'payUrl', 'autopay', 'createdAt', 'createdBy', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.kind in billKinds()
          && optString(request.resource.data, 'from', 200)
          && optString(request.resource.data, 'subject', 200)
          && optString(request.resource.data, 'label', 200)
          && ('from' in request.resource.data || 'subject' in request.resource.data || 'label' in request.resource.data)
          && optLink(request.resource.data, 'payUrl')
          && (request.resource.data.autopay == null || request.resource.data.autopay is bool)
          && request.resource.data.createdAt is int
          && request.resource.data.createdBy is string
          && request.resource.data.updatedAt is int;
      }

      match /bills/{billId} {
        allow read, delete: if staff();
        allow create, update: if staff()
          && request.resource.data.keys().hasOnly(['schema', 'source', 'sourceId', 'kind', 'label', 'due', 'amountDue', 'status', 'autopay', 'period', 'payUrl', 'repeat', 'emailId', 'paidAt', 'paidBy', 'paidVia', 'dismissed', 'createdAt', 'createdBy', 'updatedAt', 'observedAt'])
          && request.resource.data.schema == 'bill/v1'
          && request.resource.data.source in ['email', 'manual']
          && optString(request.resource.data, 'sourceId', 100)
          && request.resource.data.kind in billKinds()
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 60
          && (request.resource.data.due == null || isYmd(request.resource.data.due))
          && billMoney(request.resource.data.amountDue)
          && request.resource.data.status in ['due', 'paid', 'credit', 'unknown']
          && billAutopay(request.resource.data.autopay)
          && (!('period' in request.resource.data) || (request.resource.data.period is map
            && request.resource.data.period.keys().hasOnly(['start', 'end'])
            && isYmd(request.resource.data.period.start) && isYmd(request.resource.data.period.end)))
          && optLink(request.resource.data, 'payUrl')
          && (!('repeat' in request.resource.data) || request.resource.data.repeat in ['weekly', 'monthly', 'quarterly', 'yearly'])
          && optString(request.resource.data, 'emailId', 200)
          && (!('paidAt' in request.resource.data) || request.resource.data.paidAt is int)
          && optString(request.resource.data, 'paidBy', 200)
          && (!('paidVia' in request.resource.data) || request.resource.data.paidVia in ['member', 'email'])
          && (!('dismissed' in request.resource.data) || request.resource.data.dismissed is bool)
          && request.resource.data.createdAt is int
          && request.resource.data.createdBy is string
          && request.resource.data.updatedAt is int
          && (!('observedAt' in request.resource.data) || request.resource.data.observedAt is int);
      }

      // A regular charge Bills found in the household's card spending, once a member has answered
      // it: added as a bill, or "Not a bill". Keyed by the merchant key, so it is never offered again.
      match /billSuggestions/{key} {
        allow read, delete: if staff();
        allow create, update: if staff()
          && request.resource.data.keys().hasOnly(['status', 'name', 'billId', 'by', 'at'])
          && request.resource.data.status in ['added', 'dismissed']
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && optString(request.resource.data, 'billId', 100)
          && request.resource.data.by == myEmail()
          && request.resource.data.at is int;
      }

      // One per member, keyed by their email: only they record their own check.
      match /billSync/{email} {
        allow read: if staff();
        allow create, update: if staff()
          && email == myEmail()
          && request.resource.data.keys().hasOnly(['checkedAt', 'by', 'sources', 'emails', 'bills', 'errors'])
          && request.resource.data.by == myEmail()
          && request.resource.data.checkedAt is int
          && request.resource.data.sources is int
          && request.resource.data.emails is int
          && request.resource.data.bills is int
          && request.resource.data.errors is list
          && request.resource.data.errors.size() <= 20;
        allow delete: if staff() && email == myEmail();
      }

      // Huishouden Pet: pets, care reminders and the doses given, appointments, weights, records, the
      // daily feeding board and medicine courses.
      // Field lists match FIELDS in huishouden/pet src/lib/model.ts; keep them in step.
      function petStr(d, k, min, max) {
        return d[k] is string && d[k].size() >= min && d[k].size() <= max;
      }
      function petOptStr(d, k, max) {
        return !(k in d) || petStr(d, k, 0, max);
      }
      function petOptInt(d, k) {
        return !(k in d) || d[k] is int;
      }
      function petYmd(d, k) {
        return d[k] is string && d[k].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }
      function petAuthored(d) {
        return d.createdAt is int && petOptInt(d, 'updatedAt') && petStr(d, 'by', 3, 254);
      }

      match /petProfiles/{petId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([])
          && request.resource.data.keys().hasOnly(['name', 'species', 'breed', 'birthDate', 'birthDateApprox', 'weightUnit', 'targetWeight', 'targetNote', 'notes', 'createdAt', 'updatedAt', 'by'])
          && petStr(request.resource.data, 'name', 1, 60)
          && request.resource.data.species in ['dog', 'cat', 'rabbit', 'bird', 'fish', 'reptile', 'small pet', 'other']
          && request.resource.data.weightUnit in ['kg', 'lb']
          && petOptStr(request.resource.data, 'breed', 60)
          && (!('birthDate' in request.resource.data) || petYmd(request.resource.data, 'birthDate'))
          && (!('birthDateApprox' in request.resource.data) || (request.resource.data.birthDateApprox is bool
            && 'birthDate' in request.resource.data))
          && (!('targetWeight' in request.resource.data) || (request.resource.data.targetWeight is number
            && request.resource.data.targetWeight > 0 && request.resource.data.targetWeight < 1000))
          && petOptStr(request.resource.data, 'targetNote', 200)
          && petOptStr(request.resource.data, 'notes', 1000)
          && petAuthored(request.resource.data);
      }

      match /petReminders/{reminderId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer(['lastDoneAt', 'due', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['petId', 'kind', 'title', 'every', 'unit', 'due', 'lastDoneAt', 'notes', 'dismissedAt', 'createdAt', 'updatedAt', 'by'])
          // Dismissed: no longer comes due, kept in the pet's history.
          && petOptInt(request.resource.data, 'dismissedAt')
          && petStr(request.resource.data, 'petId', 1, 128)
          && request.resource.data.kind in ['flea-tick', 'heartworm', 'vaccine', 'deworming', 'medication', 'other']
          // Ticking off a medicine reminder records it given: never by a kid.
          && (role() != 'kid' || request.method == 'create' || addedByMe()
            || !(resource.data.kind in ['flea-tick', 'heartworm', 'deworming', 'medication']))
          && petStr(request.resource.data, 'title', 1, 80)
          && ('every' in request.resource.data) == ('unit' in request.resource.data)
          && (!('every' in request.resource.data) || (request.resource.data.every is int
            && request.resource.data.every >= 1 && request.resource.data.every <= 365
            && request.resource.data.unit in ['day', 'week', 'month', 'year']))
          && petYmd(request.resource.data, 'due')
          && petOptInt(request.resource.data, 'lastDoneAt')
          && petOptStr(request.resource.data, 'notes', 500)
          && petAuthored(request.resource.data);
      }

      // Doses given for a care reminder (flea and tick, heartworm, medication): never by kids.
      match /petDoses/{doseId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([]) && role() != 'kid'
          && request.resource.data.keys().hasOnly(['petId', 'reminderId', 'title', 'at', 'by', 'createdAt', 'via'])
          && viaOk(request.resource.data)
          && petStr(request.resource.data, 'petId', 1, 128)
          && petStr(request.resource.data, 'reminderId', 1, 128)
          && petStr(request.resource.data, 'title', 1, 80)
          && request.resource.data.at is int
          && petAuthored(request.resource.data);
      }

      match /petAppointments/{appointmentId} {
        allow read: if readable();
        allow delete: if canRemove() && (staff() || openBefore());
        allow create, update: if writer([]) && privateFlag()
          && request.resource.data.keys().hasOnly(['petIds', 'kind', 'title', 'at', 'location', 'notes', 'contactId', 'calendarEventId', 'calendarLink', 'private', 'createdAt', 'by', 'via'])
          && viaOk(request.resource.data)
          && request.resource.data.petIds is list
          && request.resource.data.petIds.size() <= 10
          && request.resource.data.kind in ['vet', 'grooming', 'boarding', 'other']
          && petStr(request.resource.data, 'title', 1, 120)
          && request.resource.data.at is int
          && petOptStr(request.resource.data, 'location', 200)
          && petOptStr(request.resource.data, 'notes', 500)
          && petOptStr(request.resource.data, 'contactId', 128)
          && petOptStr(request.resource.data, 'calendarEventId', 1024)
          && (!('calendarLink' in request.resource.data) || (petStr(request.resource.data, 'calendarLink', 9, 2000)
            && request.resource.data.calendarLink.matches('https://.*')))
          && petAuthored(request.resource.data);
      }

      match /petWeights/{weightId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([])
          && request.resource.data.keys().hasOnly(['petId', 'at', 'value', 'unit', 'by', 'createdAt'])
          && petStr(request.resource.data, 'petId', 1, 128)
          && request.resource.data.at is int
          && request.resource.data.value is number
          && request.resource.data.value > 0
          && request.resource.data.value < 2000
          && request.resource.data.unit in ['kg', 'lb']
          && petAuthored(request.resource.data);
      }

      match /petRecords/{recordId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([])
          && request.resource.data.keys().hasOnly(['petId', 'title', 'date', 'text', 'createdAt', 'updatedAt', 'by'])
          && petStr(request.resource.data, 'petId', 1, 128)
          && petStr(request.resource.data, 'title', 1, 120)
          && petYmd(request.resource.data, 'date')
          && petOptStr(request.resource.data, 'text', 2000)
          && petAuthored(request.resource.data);
      }

      // The daily feeding board: each pet's meals (AM, PM, ...) and the feeds that tick them.
      match /petMeals/{mealId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([])
          && request.resource.data.keys().hasOnly(['petId', 'name', 'time', 'food', 'portion', 'note', 'createdAt', 'updatedAt', 'by'])
          && petStr(request.resource.data, 'petId', 1, 128)
          && petStr(request.resource.data, 'name', 1, 40)
          && request.resource.data.time is string
          && request.resource.data.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
          && petOptStr(request.resource.data, 'food', 80)
          && petOptStr(request.resource.data, 'portion', 40)
          && petOptStr(request.resource.data, 'note', 200)
          && petAuthored(request.resource.data);
      }

      match /petFeedings/{feedingId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([])
          && request.resource.data.keys().hasOnly(['petId', 'mealId', 'at', 'portion', 'note', 'by', 'createdAt', 'updatedAt', 'via'])
          && viaOk(request.resource.data)
          && petStr(request.resource.data, 'petId', 1, 128)
          && petOptStr(request.resource.data, 'mealId', 128)
          && request.resource.data.at is int
          && petOptStr(request.resource.data, 'portion', 40)
          && petOptStr(request.resource.data, 'note', 200)
          && petAuthored(request.resource.data);
      }

      // Short medicine courses ("1 tablet twice a day for 7 days") and the doses given.
      // Who may give a course: admins and members always; helpers when `givers` is 'all' (the
      // default) or they are in `approvedHelpers`; kids never. Only admins and members set it.
      match /petMedCourses/{courseId} {
        allow read: if isMember();
        allow delete: if staff();
        allow create, update: if staff()
          && request.resource.data.keys().hasOnly(['petId', 'name', 'dose', 'timesPerDay', 'times', 'startDate', 'days', 'withFood', 'notes', 'givers', 'approvedHelpers', 'createdAt', 'updatedAt', 'by'])
          && (!('givers' in request.resource.data) || request.resource.data.givers in ['all', 'approved'])
          && (!('approvedHelpers' in request.resource.data) || hhEmails(request.resource.data.approvedHelpers))
          && petStr(request.resource.data, 'petId', 1, 128)
          && petStr(request.resource.data, 'name', 1, 80)
          && petStr(request.resource.data, 'dose', 0, 80)
          && request.resource.data.timesPerDay is int
          && request.resource.data.timesPerDay >= 1
          && request.resource.data.timesPerDay <= 6
          && request.resource.data.times is list
          && request.resource.data.times.size() == request.resource.data.timesPerDay
          && petYmd(request.resource.data, 'startDate')
          && request.resource.data.days is int
          && request.resource.data.days >= 1
          && request.resource.data.days <= 365
          && request.resource.data.withFood is bool
          && petOptStr(request.resource.data, 'notes', 500)
          && petAuthored(request.resource.data);
      }

      // One small avatar photo per pet, keyed by the pet's id, apart from the profile so lists stay
      // light: a WebP or JPEG data URL (@huishouden/pwa-kit/photo), at most 100 000 characters.
      match /petPhotos/{petId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([])
          && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'by'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 100000
          && request.resource.data.data.matches('data:image/(webp|jpeg);base64,[A-Za-z0-9+/]+={0,2}')
          && request.resource.data.updatedAt is int
          && petStr(request.resource.data, 'by', 3, 254);
      }

      function approvedFor(course) {
        return course.get('givers', 'all') == 'all' || myEmail() in course.get('approvedHelpers', []);
      }

      function mayGive(courseId) {
        return staff() || (role() == 'helper'
          && approvedFor(get(/databases/$(database)/documents/households/$(householdId)/petMedCourses/$(courseId)).data));
      }

      match /petMedDoses/{doseId} {
        allow read: if isMember();
        allow delete: if canRemove();
        allow create, update: if writer([])
          && petStr(request.resource.data, 'courseId', 1, 128)
          && mayGive(request.resource.data.courseId)
          && request.resource.data.keys().hasOnly(['petId', 'courseId', 'slot', 'at', 'skipped', 'by', 'createdAt', 'via'])
          && viaOk(request.resource.data)
          // Skipped rather than given.
          && (!('skipped' in request.resource.data) || request.resource.data.skipped is bool)
          && petStr(request.resource.data, 'petId', 1, 128)
          && petStr(request.resource.data, 'courseId', 1, 128)
          && request.resource.data.slot is int
          && request.resource.data.slot >= 0
          && request.resource.data.slot <= 5
          && request.resource.data.at is int
          && petAuthored(request.resource.data);
      }

      // Each member's own name and photo (@huishouden/pwa-kit/household saveMyProfile), keyed by
      // their email; only that member writes it.
      match /profiles/{email} {
        allow read: if isMember();
        allow write: if isMember()
          && email == myEmail()
          && request.resource.data.keys().hasOnly(['name', 'photoURL', 'lang', 'timeZone', 'updatedAt'])
          && request.resource.data.updatedAt is int
          // The member's language and time zone ("Europe/Amsterdam"), so what answers for them away
          // from their devices (their AI assistant, through huishouden/connector) speaks and counts
          // days their way.
          && (!('lang' in request.resource.data) || request.resource.data.lang in ['en', 'es', 'nl'])
          && (!('timeZone' in request.resource.data) || (request.resource.data.timeZone is string
            && request.resource.data.timeZone.matches('[A-Za-z0-9_+-]{1,32}(/[A-Za-z0-9_+-]{1,32}){0,2}')))
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
          && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.matches('https://.*') && request.resource.data.photoURL.size() <= 500));
        allow delete: if isMember() && email == myEmail();
      }

      // The household's contacts, shared by every app (@huishouden/pwa-kit/contacts; fields match
      // CONTACT_FIELDS and CONTACT_LIMITS there). Links are web addresses only, never javascript: or
      // data: URLs, since every app renders them as links.
      match /contacts/{contactId} {
        allow read: if readable();
        allow delete: if canRemove() && (staff() || openBefore());
        allow create, update: if writer([]) && privateFlag()
          && request.resource.data.keys().hasOnly(['name', 'role', 'phone', 'email', 'website', 'address', 'mapsUrl', 'notes', 'apps', 'private', 'createdAt', 'updatedAt', 'by', 'via'])
          && viaOk(request.resource.data)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.apps is list
          && request.resource.data.apps.size() <= 20
          && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000))
          && (!('address' in request.resource.data) || (request.resource.data.address is string && request.resource.data.address.size() <= 300))
          && optString(request.resource.data, 'role', 60)
          && optString(request.resource.data, 'phone', 40)
          && optString(request.resource.data, 'email', 120)
          && (!('website' in request.resource.data) || (request.resource.data.website is string
            && request.resource.data.website.size() <= 300 && request.resource.data.website.matches('(?i)https?://.+')))
          && (!('mapsUrl' in request.resource.data) || (request.resource.data.mapsUrl is string
            && request.resource.data.mapsUrl.size() <= 2000 && request.resource.data.mapsUrl.matches('https://.+')))
          && hhAppNames(request.resource.data.apps);
      }

      // Reminders any app schedules for the household (@huishouden/pwa-kit/reminders; fields match
      // REMINDER_FIELDS there). The shared sender (huishouden/notify) finds due, unsent ones with a
      // service account, pushes them and marks them sent.
      function hhStr(d, k, lo, hi) {
        return d[k] is string && d[k].size() >= lo && d[k].size() <= hi;
      }

      // Up to 12 lowercase emails (as memberEmails, possibly none).
      function hhEmails(l) {
        let one = '[^ @A-Z]{1,128}@[^ @A-Z]{1,128}';
        return l is list && l.size() <= 12
          && (l.size() == 0 || (l.join(' ').matches(one + '( ' + one + ')*') && l.join(' ').split(' ') == l));
      }

      // Words of a record in other languages (@huishouden/pwa-kit/i18n, docs/i18n.md): `texts` maps
      // 'en', 'es' or 'nl' to the record's own text fields in that language, each no longer than the
      // field it translates, so the portal and the sender show each reader their own. Rules have
      // no loops, so every language and field is named.
      // Each language's words: only the record's own text fields, all strings, together no longer than those fields' limits added up. Kept to a few
      // expressions: a request may evaluate at most 1000, and a to-do's checks are already many.
      function hhReminderText(m) {
        return m is map && m.keys().hasOnly(['title', 'body']) && hhStr(m, 'title', 1, 120) && m.get('body', '') is string
          && m.values().join('').size() <= 620;
      }

      function hhTodoText(m) {
        return m is map && m.keys().hasOnly(['title', 'detail', 'done', 'cancel'])
          && m.get('title', '') is string && m.get('detail', '') is string && m.get('done', '') is string && m.get('cancel', '') is string
          && m.values().join('').size() <= 368;
      }

      function hhAgendaText(m) {
        return m is map && m.keys().hasOnly(['title', 'detail']) && m.get('title', '') is string && m.get('detail', '') is string
          && m.values().join('').size() <= 320;
      }

      function hhTexts(d, kind) {
        let t = d.get('texts', {});
        return t is map && t.keys().hasOnly(['en', 'es', 'nl'])
          && (kind != 'reminder' || ((!('en' in t) || hhReminderText(t.en)) && (!('es' in t) || hhReminderText(t.es)) && (!('nl' in t) || hhReminderText(t.nl))))
          && (kind != 'todo' || ((!('en' in t) || hhTodoText(t.en)) && (!('es' in t) || hhTodoText(t.es)) && (!('nl' in t) || hhTodoText(t.nl))))
          && (kind != 'agenda' || ((!('en' in t) || hhAgendaText(t.en)) && (!('es' in t) || hhAgendaText(t.es)) && (!('nl' in t) || hhAgendaText(t.nl))));
      }

      //
      // Reminders and agenda items are worked out from each app's data on whichever device opens
      // it, the shared tablet included, so helpers and kids keep the open ones in step too: any
      // that aren't private and aren't Spending's or Bills'.
      // Spending's and Bills' items are always private. A helper's items link only into the apps
      // (the portal opens the link, the sender pushes it) and never re-arm a sent reminder.
      function openDerived() {
        return (staff() && (!moneyApp(request.resource.data.app) || request.resource.data.get('private', true) == true))
          || (helping() && !moneyApp(request.resource.data.app) && privateFlag()
            && (request.method == 'create' || !moneyApp(resource.data.app))
            && request.resource.data.by == myEmail()
            && request.resource.data.url.matches('https://huishouden(-[a-z]+)*[.]web[.]app/.*')
            && (request.method == 'create' || resource.data.get('sent', false) == false || request.resource.data.get('sent', false) == true));
      }

      function openDerivedRemoval() {
        return staff() || (helping() && openBefore() && !moneyApp(resource.data.app));
      }

      match /reminders/{reminderId} {
        allow read: if readable();
        allow delete: if openDerivedRemoval();
        allow create, update: if openDerived()
          && request.resource.data.keys().hasOnly(['app', 'title', 'body', 'texts', 'at', 'url', 'recipients', 'ref', 'private', 'sent', 'sentAt', 'createdAt', 'by'])
          && hhStr(request.resource.data, 'app', 1, 40)
          && hhStr(request.resource.data, 'title', 1, 120)
          && hhStr(request.resource.data, 'body', 0, 500)
          && hhTexts(request.resource.data, 'reminder')
          && request.resource.data.at is int
          && hhStr(request.resource.data, 'url', 1, 2000)
          && request.resource.data.url.matches('https://.*')
          && (request.resource.data.recipients == 'all'
            || (request.resource.data.recipients is list
              && request.resource.data.recipients.size() >= 1
              && request.resource.data.recipients.size() <= 12))
          && (!('ref' in request.resource.data) || hhStr(request.resource.data, 'ref', 0, 200))
          && request.resource.data.sent is bool
          && (!('sentAt' in request.resource.data) || request.resource.data.sentAt is int)
          && request.resource.data.createdAt is int
          && hhStr(request.resource.data, 'by', 0, 120);
      }

      // What a calendar needs from an agenda item (@huishouden/pwa-kit/calendar-export): `series`, the
      // schedule an occurrence belongs to, so it shows as one repeating event; `edit`, the writes that
      // carry a change made in the person's own calendar back to the record. The kit checks their
      // contents; huishouden/calendar applies an edit as the person, so each write meets its own
      // collection's rules. `calendarDetail`: more than the portal shows (a Health dose's medicine
      // names), only for the reader's own calendar when they ask for detail; it never leaves the
      // item's readers.
      function agendaExport(d) {
        return (!('series' in d) || (d.series is map
            && d.series.keys().hasOnly(['rule', 'time', 'minutes', 'original', 'through'])
            && d.series.rule is map && isYmd(d.series.original) && isYmd(d.series.through)))
          && (!('edit' in d) || (d.edit is map && d.edit.size() <= 6
            && d.edit.keys().hasOnly(['reschedule', 'retime', 'rename', 'notes', 'skip', 'cancel'])))
          && (!('calendarDetail' in d) || hhStr(d, 'calendarDetail', 0, 200));
      }

      // The household agenda (@huishouden/pwa-kit/agenda; fields match AGENDA_FIELDS there): every
      // app's dated things in one place, so the portal shows one calendar and a Today view. Admins and
      // members read all of it, helpers and kids the items with `private: false`; whoever writes an
      // item is recorded as `by`.
      match /agenda/{itemId} {
        allow read: if readable();
        allow delete: if openDerivedRemoval();
        allow create, update: if openDerived()
          && request.resource.data.keys().hasOnly(['app', 'ref', 'kind', 'title', 'start', 'end', 'allDay', 'detail', 'url', 'who', 'status', 'private', 'texts', 'series', 'edit', 'calendarDetail', 'updatedAt', 'by'])
          && hhTexts(request.resource.data, 'agenda')
          && agendaExport(request.resource.data)
          && hhStr(request.resource.data, 'app', 1, 40)
          && hhStr(request.resource.data, 'ref', 1, 200)
          && request.resource.data.kind in ['appointment', 'due', 'renewal', 'bill', 'birthday', 'medicine', 'feeding', 'task', 'other']
          && hhStr(request.resource.data, 'title', 1, 120)
          && request.resource.data.start is int
          && (!('end' in request.resource.data) || (request.resource.data.end is int
            && request.resource.data.end > request.resource.data.start))
          && request.resource.data.allDay is bool
          && (!('detail' in request.resource.data) || hhStr(request.resource.data, 'detail', 0, 200))
          && hhStr(request.resource.data, 'url', 9, 2000)
          && request.resource.data.url.matches('^https://.*')
          && (!('who' in request.resource.data) || hhStr(request.resource.data, 'who', 0, 60))
          && (!('status' in request.resource.data) || request.resource.data.status in ['upcoming', 'overdue', 'done'])
          && request.resource.data.updatedAt is int
          && request.resource.data.by == myEmail();
      }

      // The household's to-do list (@huishouden/pwa-kit/todos; fields match TODO_FIELDS and
      // TODO_ACTION_FIELDS there): every app's open, actionable things, `<app>:<ref>`, kept in step
      // like the agenda by whichever device opens an app. `done` and `cancel` are lists of writes
      // the portal makes as the member who taps them, so each is checked by its own collection's
      // rules; rules have no loops, so here only their shape is checked, and the portal refuses
      // writes outside the item's app (todoOpsAllowed).
      function todoAction(a) {
        return todoActionShape(a) && (!('emails' in a) || hhEmails(a.emails));
      }

      function todoActionShape(a) {
        return a is map
          && a.keys().hasOnly(['label', 'ops', 'roles', 'owner', 'emails'])
          // label, ops and roles are required: reading a missing one fails the check.
          && hhStr(a, 'label', 1, 24)
          && a.ops is list && a.ops.size() >= 1 && a.ops.size() <= 8
          && a.roles is list && a.roles.size() <= 4 && a.roles.hasOnly(['admin', 'member', 'helper', 'kid'])
          && (!('owner' in a) || a.owner is bool);
      }

      // A personal to-do's action names only people who read it: its `emails` are some of its
      // `audience`, which hhEmails has checked. Checking them against it, rather than as emails
      // again, keeps a Health to-do (an audience, two actions with givers, three languages) within
      // the 1000 expressions a request may evaluate.
      function personalTodoAction(a, audience) {
        return todoActionShape(a) && (!('emails' in a) || (a.emails is list && a.emails.size() <= 12 && a.emails.hasOnly(audience)));
      }

      match /todos/{todoId} {
        allow read: if readable();
        allow delete: if openDerivedRemoval();
        allow create, update: if openDerived()
          && request.resource.data.keys().hasOnly(['app', 'ref', 'title', 'detail', 'createdAt', 'due', 'who', 'url', 'status', 'private', 'owner', 'done', 'cancel', 'texts', 'updatedAt', 'by'])
          && hhTexts(request.resource.data, 'todo')
          && hhStr(request.resource.data, 'app', 1, 40)
          && request.resource.data.app.matches('[a-z]{1,40}')
          && todoId.matches(request.resource.data.app + ':.{1,240}')
          && hhStr(request.resource.data, 'ref', 1, 200)
          && hhStr(request.resource.data, 'title', 1, 120)
          && (!('detail' in request.resource.data) || hhStr(request.resource.data, 'detail', 0, 200))
          && request.resource.data.createdAt is int
          && (!('due' in request.resource.data) || request.resource.data.due is int)
          && (!('who' in request.resource.data) || hhStr(request.resource.data, 'who', 0, 60))
          && hhStr(request.resource.data, 'url', 9, 2000)
          && request.resource.data.url.matches('^https://.*')
          && request.resource.data.status in ['open', 'info']
          && (!('owner' in request.resource.data) || hhStr(request.resource.data, 'owner', 0, 254))
          && (!('done' in request.resource.data) || todoAction(request.resource.data.done))
          && (!('cancel' in request.resource.data) || todoAction(request.resource.data.cancel))
          && request.resource.data.updatedAt is int
          && request.resource.data.by == myEmail();
      }

      // Health (huishouden/health): people's medicines. Everything about a person is readable only by
      // the household's admins and the members in the person's `readers` (their carers, and the
      // person themself when they are a member), never by kids, nor by members who don't care for
      // them. Admins and member carers keep the person and their medicines; helper carers read and
      // record doses. A person's medicines, doses and photo live under the person, so every check
      // reads the person document by its path (list queries included).
      function healthAdmin() {
        return isMember() && role() == 'admin';
      }

      function healthReader(p) {
        return healthAdmin() || (isMember() && role() in ['member', 'helper'] && myEmail() in p.readers);
      }

      function healthKeeper(p) {
        return healthAdmin() || (isMember() && role() == 'member' && myEmail() in p.readers);
      }

      function healthYmd(d, k) {
        return d[k] is string && d[k].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }

      function healthNum(d, k, lo, hi) {
        return !(k in d) || (d[k] is number && d[k] >= lo && d[k] <= hi);
      }

      function healthInt(d, k, lo, hi) {
        return !(k in d) || (d[k] is int && d[k] >= lo && d[k] <= hi);
      }

      // "HH:MM" times, up to six, checked as one string (rules have no loops).
      function healthTimes(l) {
        let one = '([01][0-9]|2[0-3]):[0-5][0-9]';
        return l is list && l.size() <= 6
          && (l.size() == 0 || (l.join('|').matches(one + '([|]' + one + ')*') && l.join('|').split('[|]') == l));
      }

      function healthAuthored(d) {
        return d.createdAt is int && healthInt(d, 'updatedAt', 0, 9999999999999) && d.by == myEmail();
      }

      match /healthPeople/{personId} {
        allow read: if healthReader(resource.data);
        allow delete: if healthKeeper(resource.data);
        allow create, update: if (healthAdmin()
            || (isMember() && role() == 'member' && myEmail() in request.resource.data.readers
              && (request.method == 'create' || myEmail() in resource.data.readers)))
          && request.resource.data.keys().hasOnly(['name', 'birthDate', 'email', 'carers', 'readers', 'allergies', 'notes', 'createdAt', 'updatedAt', 'by'])
          && hhStr(request.resource.data, 'name', 1, 60)
          && (!('birthDate' in request.resource.data) || healthYmd(request.resource.data, 'birthDate'))
          && (!('email' in request.resource.data) || (hhStr(request.resource.data, 'email', 3, 254)
            && request.resource.data.email == request.resource.data.email.lower()
            && request.resource.data.email in request.resource.data.readers))
          && hhEmails(request.resource.data.carers)
          && hhEmails(request.resource.data.readers)
          && request.resource.data.readers.hasAll(request.resource.data.carers)
          && optString(request.resource.data, 'allergies', 200)
          && optString(request.resource.data, 'notes', 500)
          && healthAuthored(request.resource.data);

        function person() {
          return get(/databases/$(database)/documents/households/$(householdId)/healthPeople/$(personId)).data;
        }

        // One small avatar photo (@huishouden/pwa-kit/photo), `avatar`.
        match /photo/{photoId} {
          allow read: if healthReader(person());
          allow delete: if healthKeeper(person());
          allow create, update: if photoId == 'avatar' && healthKeeper(person())
            && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'by'])
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 100000
            && request.resource.data.data.matches('data:image/(webp|jpeg);base64,[A-Za-z0-9+/]+={0,2}')
            && request.resource.data.updatedAt is int
            && request.resource.data.by == myEmail();
        }

        // A medicine: scheduled at `times` on its days (every `everyDays`, or on `rule`), or as needed
        // with `minHours` between doses and at most `maxPerDay`. Readers may also mark a refill
        // ordered (`refillOrderedAt`, the household to-do's "Ordered"). `personId` repeats the path's.
        match /meds/{medId} {
          allow read: if healthReader(person());
          allow delete: if healthKeeper(person());
          allow update: if healthReader(person())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refillOrderedAt', 'updatedAt'])
            && request.resource.data.get('refillOrderedAt', 0) is int
            && request.resource.data.get('updatedAt', 0) is int;
          allow create, update: if healthKeeper(person())
            && request.resource.data.get('personId', '') == personId
            && request.resource.data.keys().hasOnly(['personId', 'name', 'strength', 'dose', 'doseAmount', 'doseUnit', 'asNeeded', 'times', 'everyDays', 'rule', 'minHours', 'maxPerDay', 'withFood', 'startDate', 'endDate', 'prescriberId', 'pharmacyId', 'refills', 'supply', 'supplyAt', 'refillOrderedAt', 'escalateMinutes', 'remind', 'notes', 'createdAt', 'updatedAt', 'by', 'via'])
            && viaOk(request.resource.data)
            && hhStr(request.resource.data, 'name', 1, 80)
            && optString(request.resource.data, 'strength', 40)
            && optString(request.resource.data, 'dose', 80)
            && (!('doseAmount' in request.resource.data) || (request.resource.data.doseAmount is number
              && request.resource.data.doseAmount > 0 && request.resource.data.doseAmount <= 1000))
            && optString(request.resource.data, 'doseUnit', 20)
            && request.resource.data.asNeeded is bool
            && healthTimes(request.resource.data.times)
            && healthInt(request.resource.data, 'everyDays', 1, 31)
            && (!('rule' in request.resource.data) || (request.resource.data.rule is map && request.resource.data.rule.size() <= 7))
            && healthNum(request.resource.data, 'minHours', 0, 72)
            && healthInt(request.resource.data, 'maxPerDay', 1, 24)
            && (!('withFood' in request.resource.data) || request.resource.data.withFood is bool)
            && healthYmd(request.resource.data, 'startDate')
            && (!('endDate' in request.resource.data) || healthYmd(request.resource.data, 'endDate'))
            && optString(request.resource.data, 'prescriberId', 128)
            && optString(request.resource.data, 'pharmacyId', 128)
            && healthInt(request.resource.data, 'refills', 0, 99)
            && healthNum(request.resource.data, 'supply', 0, 10000)
            && healthInt(request.resource.data, 'supplyAt', 0, 9999999999999)
            && healthInt(request.resource.data, 'refillOrderedAt', 0, 9999999999999)
            && request.resource.data.escalateMinutes is int
            && request.resource.data.escalateMinutes >= 0
            && request.resource.data.escalateMinutes <= 240
            && request.resource.data.remind is bool
            && optString(request.resource.data, 'notes', 500)
            && healthAuthored(request.resource.data);
        }

        // Doses given or skipped, by whoever recorded them: a scheduled one answers its `slot`
        // ("YYYY-MM-DDTHH:MM"), an as-needed one has none. Helpers change only their own.
        match /doses/{doseId} {
          allow read: if healthReader(person());
          allow delete: if healthKeeper(person()) || (healthReader(person()) && resource.data.by == myEmail());
          allow create, update: if healthReader(person())
            && (request.method == 'create' || healthKeeper(person()) || resource.data.by == myEmail())
            && (request.method == 'create' ? request.resource.data.by == myEmail() : request.resource.data.by == resource.data.by)
            && request.resource.data.get('personId', '') == personId
            && request.resource.data.keys().hasOnly(['personId', 'medId', 'slot', 'at', 'status', 'note', 'by', 'createdAt', 'via'])
            && viaOk(request.resource.data)
            && hhStr(request.resource.data, 'medId', 1, 128)
            && (!('slot' in request.resource.data) || (request.resource.data.slot is string
              && request.resource.data.slot.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}')))
            && request.resource.data.at is int
            && request.resource.data.status in ['given', 'skipped']
            && optString(request.resource.data, 'note', 200)
            && hhStr(request.resource.data, 'by', 3, 254)
            && request.resource.data.createdAt is int;
        }
      }

      // For named people only (@huishouden/pwa-kit/audience): agenda items, to-dos and reminders
      // about one person's care, read, written and removed only by the members in `audience` (the
      // writer among them). Kids never write them; apps never name kids. Links lead into the suite.
      function audienceRead() {
        return isMember() && myEmail() in resource.data.audience;
      }

      function audienceWrite() {
        return isMember() && role() != 'kid'
          && request.resource.data.by == myEmail()
          && hhEmails(request.resource.data.audience)
          && request.resource.data.audience.size() >= 1
          && myEmail() in request.resource.data.audience
          && (request.method == 'create' || myEmail() in resource.data.audience)
          && request.resource.data.url.matches('https://huishouden(-[a-z]+)*[.]web[.]app/.*');
      }

      match /personalAgenda/{itemId} {
        allow read, delete: if audienceRead();
        allow create, update: if audienceWrite()
          && request.resource.data.keys().hasOnly(['app', 'ref', 'kind', 'title', 'start', 'end', 'allDay', 'detail', 'url', 'who', 'status', 'private', 'texts', 'series', 'edit', 'calendarDetail', 'audience', 'updatedAt', 'by'])
          && hhTexts(request.resource.data, 'agenda')
          && agendaExport(request.resource.data)
          && hhStr(request.resource.data, 'app', 1, 40)
          && hhStr(request.resource.data, 'ref', 1, 200)
          && request.resource.data.kind in ['appointment', 'due', 'renewal', 'bill', 'birthday', 'medicine', 'feeding', 'task', 'other']
          && hhStr(request.resource.data, 'title', 1, 120)
          && request.resource.data.start is int
          && (!('end' in request.resource.data) || (request.resource.data.end is int
            && request.resource.data.end > request.resource.data.start))
          && request.resource.data.allDay is bool
          && (!('detail' in request.resource.data) || hhStr(request.resource.data, 'detail', 0, 200))
          && hhStr(request.resource.data, 'url', 9, 2000)
          && (!('who' in request.resource.data) || hhStr(request.resource.data, 'who', 0, 60))
          && (!('status' in request.resource.data) || request.resource.data.status in ['upcoming', 'overdue', 'done'])
          && request.resource.data.get('private', true) is bool
          && request.resource.data.updatedAt is int;
      }

      match /personalTodos/{todoId} {
        allow read, delete: if audienceRead();
        allow create, update: if audienceWrite()
          && request.resource.data.keys().hasOnly(['app', 'ref', 'title', 'detail', 'createdAt', 'due', 'who', 'url', 'status', 'private', 'owner', 'done', 'cancel', 'texts', 'audience', 'updatedAt', 'by'])
          && hhTexts(request.resource.data, 'todo')
          && hhStr(request.resource.data, 'app', 1, 40)
          && request.resource.data.app.matches('[a-z]{1,40}')
          && todoId.matches(request.resource.data.app + ':.{1,240}')
          && hhStr(request.resource.data, 'ref', 1, 200)
          && hhStr(request.resource.data, 'title', 1, 120)
          && (!('detail' in request.resource.data) || hhStr(request.resource.data, 'detail', 0, 200))
          && request.resource.data.createdAt is int
          && (!('due' in request.resource.data) || request.resource.data.due is int)
          && (!('who' in request.resource.data) || hhStr(request.resource.data, 'who', 0, 60))
          && hhStr(request.resource.data, 'url', 9, 2000)
          && request.resource.data.status in ['open', 'info']
          && request.resource.data.get('private', true) is bool
          && (!('owner' in request.resource.data) || hhStr(request.resource.data, 'owner', 0, 254))
          && (!('done' in request.resource.data) || personalTodoAction(request.resource.data.done, request.resource.data.audience))
          && (!('cancel' in request.resource.data) || personalTodoAction(request.resource.data.cancel, request.resource.data.audience))
          && request.resource.data.updatedAt is int;
      }

      // The shared sender (huishouden/notify) reads these too and pushes them to `recipients`,
      // members who are in the audience. A sent one is never armed again.
      match /personalReminders/{reminderId} {
        allow read, delete: if audienceRead();
        allow create, update: if audienceWrite()
          && (request.method == 'create' || resource.data.get('sent', false) == false || request.resource.data.get('sent', false) == true)
          && request.resource.data.keys().hasOnly(['app', 'title', 'body', 'texts', 'at', 'url', 'recipients', 'ref', 'private', 'audience', 'sent', 'sentAt', 'createdAt', 'by'])
          && hhStr(request.resource.data, 'app', 1, 40)
          && hhStr(request.resource.data, 'title', 1, 120)
          && hhStr(request.resource.data, 'body', 0, 500)
          && hhTexts(request.resource.data, 'reminder')
          && request.resource.data.at is int
          && hhStr(request.resource.data, 'url', 1, 2000)
          && hhEmails(request.resource.data.recipients)
          && request.resource.data.recipients.size() >= 1
          && (!('ref' in request.resource.data) || hhStr(request.resource.data, 'ref', 0, 200))
          && request.resource.data.get('private', true) is bool
          && request.resource.data.sent is bool
          && (!('sentAt' in request.resource.data) || request.resource.data.sentAt is int)
          && request.resource.data.createdAt is int;
      }

      // Each member's calendar settings (@huishouden/pwa-kit/calendar-export, CALENDAR_SETTINGS_FIELDS):
      // which apps their calendar feed and Google Calendar show, and whether to-dos, bills, finished
      // things and Health's detail go in. Only that member reads and writes them; huishouden/calendar
      // reads them as the member. The feed's secret and Google's tokens are never here: the Worker
      // keeps them encrypted in its own storage.
      match /calendarSettings/{email} {
        allow read, delete: if isMember() && email == myEmail();
        allow create, update: if isMember() && email == myEmail()
          && request.resource.data.keys().hasOnly(['hiddenApps', 'todos', 'bills', 'healthDetail', 'done', 'updatedAt', 'by'])
          && request.resource.data.hiddenApps is list && request.resource.data.hiddenApps.size() <= 30
          && request.resource.data.todos is bool
          && request.resource.data.bills is bool
          && request.resource.data.healthDetail is bool
          && request.resource.data.done is bool
          && request.resource.data.updatedAt is int
          && request.resource.data.by == myEmail();
      }

      // Changes a member made in their Google Calendar that huishouden/calendar carried back to the
      // record (moved, renamed, skipped, cancelled), written as that member with the writes that undo
      // it. Only the member sees them, undoes them (the portal writes `undo` as them, under each
      // collection's own rules) and removes them; they are never changed.
      match /calendarChanges/{changeId} {
        allow read, delete: if isMember() && resource.data.email == myEmail();
        allow update: if false;
        allow create: if isMember()
          && changeId.matches('[A-Za-z0-9_-]{1,100}')
          && request.resource.data.keys().hasOnly(['email', 'source', 'app', 'ref', 'title', 'change', 'from', 'to', 'undo', 'at', 'by'])
          && request.resource.data.email == myEmail()
          && request.resource.data.by == myEmail()
          && request.resource.data.source == 'google'
          && hhStr(request.resource.data, 'app', 1, 40)
          && hhStr(request.resource.data, 'ref', 1, 200)
          && hhStr(request.resource.data, 'title', 1, 120)
          && request.resource.data.change in ['moved', 'retimed', 'renamed', 'notes', 'skipped', 'cancelled']
          && (!('from' in request.resource.data) || hhStr(request.resource.data, 'from', 0, 200))
          && (!('to' in request.resource.data) || hhStr(request.resource.data, 'to', 0, 200))
          && request.resource.data.undo is list && request.resource.data.undo.size() <= 12
          && request.resource.data.at is int;
      }

      // AI assistants a member connected (huishouden/connector), one per grant: the member sees and
      // revokes their own; nobody else reads them. The connector writes them as the member when the
      // assistant first acts in this household, and an entry under `audit` for every tool call.
      function connectionShape(d) {
        return d.keys().hasOnly(['email', 'client', 'clientUri', 'createdAt', 'lastUsedAt', 'by'])
          && d.email == myEmail() && d.by == myEmail()
          && hhStr(d, 'client', 1, 80)
          && (!('clientUri' in d) || (hhStr(d, 'clientUri', 9, 300) && d.clientUri.matches('https://.+')))
          && d.createdAt is int
          && (!('lastUsedAt' in d) || d.lastUsedAt is int);
      }

      match /connections/{grantId} {
        allow read, delete: if isMember() && resource.data.email == myEmail();
        allow create: if isMember() && grantId.matches('[A-Za-z0-9_-]{1,64}') && connectionShape(request.resource.data);
        allow update: if isMember() && resource.data.email == myEmail() && connectionShape(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;

        function mine() {
          return isMember() && get(/databases/$(database)/documents/households/$(householdId)/connections/$(grantId)).data.email == myEmail();
        }

        // What the assistant did: the tool, whether it read or wrote, and the record it touched.
        match /audit/{entryId} {
          allow read, delete: if mine();
          allow update: if false;
          allow create: if mine()
            && request.resource.data.keys().hasOnly(['tool', 'kind', 'ok', 'app', 'ref', 'at', 'by'])
            && hhStr(request.resource.data, 'tool', 1, 40)
            && request.resource.data.kind in ['read', 'write']
            && request.resource.data.ok is bool
            && (!('app' in request.resource.data) || hhStr(request.resource.data, 'app', 1, 40))
            && (!('ref' in request.resource.data) || hhStr(request.resource.data, 'ref', 1, 300))
            && request.resource.data.at is int
            && request.resource.data.by == myEmail();
        }
      }

      // Each member's Web Push subscriptions, one per device and app (@huishouden/pwa-kit/push;
      // fields match PUSH_SUBSCRIPTION_FIELDS there), with the device's language (`lang`), which the
      // sender uses to pick a reminder's `texts`. A member sees and manages only their own;
      // the keys are read only by the shared sender (huishouden/notify, a service account).
      match /pushSubscriptions/{subId} {
        allow read, delete: if isMember() && resource.data.email == myEmail();
        allow create, update: if isMember()
          && (resource == null || resource.data.email == myEmail())
          && request.resource.data.keys().hasOnly(['email', 'app', 'endpoint', 'keys', 'ua', 'lang', 'createdAt'])
          && (!('lang' in request.resource.data) || request.resource.data.lang in ['en', 'es', 'nl'])
          && request.resource.data.email == myEmail()
          && hhStr(request.resource.data, 'app', 1, 40)
          && hhStr(request.resource.data, 'endpoint', 1, 1000)
          && request.resource.data.endpoint.matches('https://.*')
          && request.resource.data['keys'] is map
          && request.resource.data['keys'].keys().hasOnly(['p256dh', 'auth'])
          && hhStr(request.resource.data['keys'], 'p256dh', 1, 200)
          && hhStr(request.resource.data['keys'], 'auth', 1, 100)
          && (!('ua' in request.resource.data) || hhStr(request.resource.data, 'ua', 0, 300))
          && request.resource.data.createdAt is int;
      }

      // The portal's tile layout for the household (huishouden/portal), one document, `portal`:
      // app repo names in the household's order, and the ones it hid. Rules have no loops, so a
      // list is checked as one string, joined with '/' (which no entry may contain); splitting it
      // back must give the same list, which fails for anything that isn't a string.
      function hhAppNames(l) {
        let joined = l.join('/');
        return l is list && l.size() <= 30
          && (l.size() == 0 || (joined.matches('[^/]{1,40}(/[^/]{1,40})*') && joined.split('/') == l));
      }

      // The household's food preferences (@huishouden/pwa-kit/food; fields match FOOD_FIELDS and
      // FOOD_LIMITS there), one document, `food`: who eats at home with their diets and what they
      // avoid, and the kitchen basics recipes may assume. A request may evaluate at most 1000
      // expressions and rules have no loops, so checking every field of up to 20 people does not
      // fit: the rules check the shape (members only, exact top-level fields, sizes, the pantry as
      // strings of 1-40 characters, `by` the signed-in member) and the kit writes each person
      // clipped to FOOD_PERSON_FIELDS and reads them defensively.
      function hhWords(l, maxItems, maxLength) {
        let joined = l.join('|');
        let item = '[^|]{1,' + string(maxLength) + '}';
        return l is list && l.size() <= maxItems
          && (l.size() == 0 || (joined.matches(item + '([|]' + item + ')*') && joined.split('[|]') == l));
      }

      match /settings/{docId} {
        allow read: if isMember();
        allow delete: if false;
        allow create, update: if staff() && (
          (docId == 'portal'
            && request.resource.data.keys().hasOnly(['order', 'hidden', 'updatedAt', 'by'])
            && hhAppNames(request.resource.data.order)
            && hhAppNames(request.resource.data.hidden)
            && request.resource.data.updatedAt is int
            && hhStr(request.resource.data, 'by', 0, 200))
          || (docId == 'food'
            && request.resource.data.keys().hasAll(['people', 'pantryAssumed', 'updatedAt', 'by'])
            && request.resource.data.keys().hasOnly(['people', 'pantryAssumed', 'updatedAt', 'by'])
            && request.resource.data.people is list
            && request.resource.data.people.size() <= 20
            && hhWords(request.resource.data.pantryAssumed, 40, 40)
            && request.resource.data.updatedAt is int
            && request.resource.data.by == myEmail())
          // Tasks: which Google Tasks lists feed which household list ({ googleListId, title,
          // listId, mode: 'add' | 'suggest' } each), and the Google task ids already taken in
          // (`handled`, the latest 500), so a task cleared from a list is not brought back. Only the
          // shape is checked (rules have no loops); Tasks writes entries clipped and reads them
          // defensively.
          || (docId == 'tasks'
            && request.resource.data.keys().hasAll(['googleTasks', 'updatedAt', 'by'])
            && request.resource.data.keys().hasOnly(['googleTasks', 'handled', 'updatedAt', 'by'])
            && request.resource.data.googleTasks is list
            && request.resource.data.googleTasks.size() <= 10
            && (!('handled' in request.resource.data) || (request.resource.data.handled is list
              && request.resource.data.handled.size() <= 500))
            && request.resource.data.updatedAt is int
            && request.resource.data.by == myEmail())
        );
      }

      // Meal ideas, favourites and the meal plan are the household's choices: admins and members.
      match /favorites/{favoriteId} {
        allow read: if isMember();
        allow write: if staff();
      }

      match /menus/{menuId} {
        allow read: if isMember();
        allow delete: if staff();
        allow create: if staff()
          && request.resource.data.meals is list
          && request.resource.data.meals.size() <= 30;
      }

      // Tasks' meal plan: one document per planned slot, "<day>_<type>" ("2031-01-06_dinner"), so two
      // members planning at once never overwrite each other's choices.
      match /mealPlan/{slotId} {
        allow read: if isMember();
        allow delete: if staff();
        allow create, update: if staff()
          && request.resource.data.keys().hasOnly(['day', 'type', 'name', 'meal', 'by', 'updatedAt'])
          && request.resource.data.day is string
          && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.type in ['breakfast', 'lunch', 'dinner']
          && slotId == request.resource.data.day + '_' + request.resource.data.type
          && hhStr(request.resource.data, 'name', 1, 120)
          && request.resource.data.meal is map
          && request.resource.data.updatedAt is int
          && request.resource.data.by == myEmail();
      }
    }
  }
}
